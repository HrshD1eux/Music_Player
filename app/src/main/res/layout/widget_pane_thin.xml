<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_widget_bg_round"
    android:clipToOutline="true"
    android:theme="@style/Theme.MusicPlayer.Widget">

    <!-- Full-bleed background album cover banner -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_remote_default_cover_24"
        tools:ignore="ContentDescription" />

    <!-- Dark gradient overlay for text readability & button contrast -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/ui_widget_scrim"
        tools:ignore="ContentDescription" />

    <!-- Overlay content: Metadata at top, Controls at bottom -->
    <RelativeLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Top text metadata: Title and Artist/Album -->
        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_song"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Talashi_Official_Video_Mankirt_..." />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp"
                tools:text="&lt;unknown&gt; • Quick Share" />

        </LinearLayout>

        <!-- Bottom playback controls: Prev, Play/Pause, Next -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_skip_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_skip_prev"
                android:scaleType="center"
                android:src="@drawable/ic_widget_skip_prev_24" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_play_pause"
                android:scaleType="center"
                android:src="@drawable/ic_widget_play_24" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/widget_skip_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_skip_next"
                android:scaleType="center"
                android:src="@drawable/ic_widget_skip_next_24" />

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
