<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_widget_bg_round"
    android:backgroundTint="?attr/colorSurface"
    android:theme="@style/Theme.MusicPlayer.Widget">

    <!-- Full background album cover -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_remote_default_cover_24"
        tools:ignore="ContentDescription" />

    <!-- Dark overlay for text readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:alpha="0.2" />

    <!-- Content overlay with metadata and controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Metadata at top -->
        <LinearLayout
            android:id="@+id/widget_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <TextView
                android:id="@+id/widget_song"
                style="@style/Widget.MusicPlayer.TextView.Primary.AppWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Song name" />

            <TextView
                android:id="@+id/widget_artist"
                style="@style/Widget.MusicPlayer.TextView.Secondary.AppWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_small"
                tools:text="Artist name" />

        </LinearLayout>

        <!-- Controls centered at bottom -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/spacing_mid_medium">

            <FrameLayout
                android:layout_width="@dimen/size_touchable_medium"
                android:layout_height="@dimen/size_touchable_medium"
                android:background="@drawable/ui_widget_circle_button_bg">

                <ImageButton
                    android:id="@+id/widget_skip_prev"
                    style="@style/Widget.MusicPlayer.MaterialButton.AppWidget"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_skip_prev"
                    android:src="@drawable/ic_skip_prev_24" />

            </FrameLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="@dimen/size_touchable_large"
                android:layout_height="@dimen/size_touchable_large"
                android:background="@drawable/ui_widget_circle_button_bg">

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    style="@style/Widget.MusicPlayer.MaterialButton.AppWidget.PlayPause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_play_pause"
                    android:src="@drawable/ic_play_24" />

            </FrameLayout>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="@dimen/size_touchable_medium"
                android:layout_height="@dimen/size_touchable_medium"
                android:background="@drawable/ui_widget_circle_button_bg">

                <ImageButton
                    android:id="@+id/widget_skip_next"
                    style="@style/Widget.MusicPlayer.MaterialButton.AppWidget"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_skip_next"
                    android:src="@drawable/ic_skip_next_24" />

            </FrameLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
